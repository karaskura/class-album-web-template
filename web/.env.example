# ============================================================
# 班级相册 · 环境变量示例
# 复制成 .env.local 后按实际情况填写（.env.local 不要提交到 git）
# ============================================================

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_NAME=班级相册

# ---------- 图片水印（2026-10-05 加，防盗用）----------
# 照片在浏览器里压缩时把这行字斜着平铺印上去，存下去/转发出去都带着它。
# 留空 = 不打水印（不建议）。改完要重新构建（npm run build）才生效。
NEXT_PUBLIC_WATERMARK=

# ---------- 数据库（PostgreSQL）----------
# 本机开发：postgres://用户名:密码@127.0.0.1:5432/class_album
# docker compose：主机名用 db，见 docker-compose.yml
DATABASE_URL=postgres://album:album_pwd@127.0.0.1:5432/class_album

# ---------- 会话签名密钥 ----------
# 必须改成一串随机字符（越长越好），生成方法：openssl rand -hex 32
SESSION_SECRET=please-change-me-to-a-long-random-string

# ---------- 图片存储驱动 ----------
# local = 存在服务器本地磁盘（局域网/开发用，零成本，开箱即用）
# oss   = 阿里云 OSS 预签名直传（生产推荐）
STORAGE_DRIVER=local

# local 驱动：图片存放目录（docker 里建议挂到 /data/media）
LOCAL_STORAGE_DIR=./.data/media

# ---------- 阿里云 OSS（STORAGE_DRIVER=oss 时必填）----------
# 地域，例如 oss-cn-hangzhou
OSS_REGION=oss-cn-hangzhou
# 公网访问域名，留空则按地域自动推导为 https://<bucket>.oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 预签名 URL 有效期（秒），默认 3600
OSS_SIGNED_URL_TTL=3600

# ---------- 首个管理员（可选，运行 npm run db:init 时自动创建）----------
BOOTSTRAP_ADMIN_STUDENT_NO=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=25
